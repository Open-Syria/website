# Keep the real file at mode 0600 on the production host. This configuration
# authenticates the host-side Infisical CLI; application secrets remain in
# Infisical and are exported to .runtime.env during prepare.
INFISICAL_API_URL=http://127.0.0.1:14001
INFISICAL_CLIENT_ID=enter-client-id
INFISICAL_CLIENT_SECRET=enter-client-secret

# Immutable ID of the OpenSyria Infisical project.
INFISICAL_PROJECT_ID=5922e0e7-9672-4195-a61f-90db3eb60ce5
INFISICAL_ENV_SLUG=production
INFISICAL_SECRET_PATH=/website
