# Local-safe defaults. Production automation enforces the opensyria.org and
# api.opensyria.org origins plus Google tag GT-WPDWW3NR.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DATASETS_API_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
DEPLOYMENT_VERSION=development

# Optional exam-marks import. All values below are runtime configuration.
# Leave disabled without your own Turnstile widget and private decoder key.
EXAM_RESULTS_ENABLED=false
EXAM_RESULTS_SITE_ORIGIN=http://localhost:3000
EXAM_RESULTS_TURNSTILE_SITE_KEY=
EXAM_RESULTS_TURNSTILE_SECRET=
EXAM_RESULTS_SIGNING_KEY=
EXAM_RESULTS_DECODER_KEY=
EXAM_RESULTS_STORE_PATH=
EXAM_RESULTS_TRUST_PROXY=false

# Production container limits and SSH destination are managed by deployment
# Compose and GitHub production-environment settings, not public app config.
