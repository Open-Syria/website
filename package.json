{
  "name": "@open-syria/website",
  "version": "0.5.3",
  "private": true,
  "description": "OpenSyria public website.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "audit:dependencies": "pnpm audit",
    "build": "next build",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "check:write:unsafe": "biome check --write --unsafe .",
    "dev": "next dev",
    "format": "biome format --write .",
    "images:admissions": "node scripts/generate-admissions-images.mjs",
    "images:brand": "node scripts/generate-brand-images.mjs",
    "lint": "biome lint .",
    "prepare": "husky",
    "start": "next start",
    "test:admissions": "node --test scripts/test-admissions.mjs scripts/test-admissions-domestic.mjs scripts/test-admissions-non-syrian.mjs scripts/test-admissions-foreign.mjs scripts/test-admissions-non-syrian-vocational.mjs scripts/test-admissions-foreign-vocational.mjs scripts/test-admissions-sharia.mjs scripts/test-admissions-older-private.mjs scripts/test-admissions-special-quotas.mjs scripts/test-admissions-service.mjs scripts/test-admissions-vocational-family.mjs",
    "test:agent-readiness": "node scripts/test-agent-readiness.mjs",
    "test:results": "node --test scripts/test-exam-results.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "biome check . && pnpm run typecheck && pnpm run test:admissions && pnpm run test:results && next build && pnpm run test:agent-readiness && pnpm run audit:dependencies",
    "verify:ci": "pnpm run verify"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-intl": "4.14.8",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "schema-dts": "^2.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^7"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
